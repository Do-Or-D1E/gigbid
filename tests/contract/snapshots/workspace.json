[
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "description": "Save an email DRAFT in the user's own mailbox (for example an interview reminder). Never sends.",
  "input_schema": {
   "properties": {
    "body": {
     "maxLength": 5000,
     "minLength": 10,
     "title": "Body",
     "type": "string"
    },
    "idempotency_key": {
     "maxLength": 128,
     "minLength": 8,
     "pattern": "^[\\w\\-:.]+$",
     "title": "Idempotency Key",
     "type": "string"
    },
    "subject": {
     "maxLength": 150,
     "minLength": 3,
     "title": "Subject",
     "type": "string"
    }
   },
   "required": [
    "subject",
    "body",
    "idempotency_key"
   ],
   "title": "create_email_draftArguments",
   "type": "object"
  },
  "name": "create_email_draft",
  "output_schema": {
   "properties": {
    "body": {
     "title": "Body",
     "type": "string"
    },
    "draft_id": {
     "title": "Draft Id",
     "type": "string"
    },
    "replay": {
     "default": false,
     "title": "Replay",
     "type": "boolean"
    },
    "status": {
     "default": "draft",
     "title": "Status",
     "type": "string"
    },
    "subject": {
     "title": "Subject",
     "type": "string"
    }
   },
   "required": [
    "draft_id",
    "subject",
    "body"
   ],
   "title": "EmailDraft",
   "type": "object"
  }
 },
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "description": "Place a TENTATIVE calendar hold for an interview slot the user approved.",
  "input_schema": {
   "properties": {
    "duration_minutes": {
     "default": 30,
     "maximum": 120,
     "minimum": 15,
     "title": "Duration Minutes",
     "type": "integer"
    },
    "idempotency_key": {
     "maxLength": 128,
     "minLength": 8,
     "pattern": "^[\\w\\-:.]+$",
     "title": "Idempotency Key",
     "type": "string"
    },
    "start": {
     "description": "ISO start time from free_slots",
     "title": "Start",
     "type": "string"
    },
    "title": {
     "maxLength": 120,
     "minLength": 3,
     "title": "Title",
     "type": "string"
    }
   },
   "required": [
    "start",
    "title",
    "idempotency_key"
   ],
   "title": "create_interview_holdArguments",
   "type": "object"
  },
  "name": "create_interview_hold",
  "output_schema": {
   "properties": {
    "end": {
     "title": "End",
     "type": "string"
    },
    "hold_id": {
     "title": "Hold Id",
     "type": "string"
    },
    "replay": {
     "default": false,
     "title": "Replay",
     "type": "boolean"
    },
    "start": {
     "title": "Start",
     "type": "string"
    },
    "status": {
     "default": "tentative",
     "title": "Status",
     "type": "string"
    },
    "title": {
     "title": "Title",
     "type": "string"
    }
   },
   "required": [
    "hold_id",
    "start",
    "end",
    "title"
   ],
   "title": "Hold",
   "type": "object"
  }
 },
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "description": "Free interview slots in working hours (09:00-17:00 UTC, weekdays), skipping busy blocks and holds.",
  "input_schema": {
   "properties": {
    "days": {
     "default": 5,
     "description": "How many days ahead to look",
     "maximum": 14,
     "minimum": 1,
     "title": "Days",
     "type": "integer"
    },
    "duration_minutes": {
     "default": 30,
     "maximum": 120,
     "minimum": 15,
     "title": "Duration Minutes",
     "type": "integer"
    },
    "max_slots": {
     "default": 3,
     "maximum": 10,
     "minimum": 1,
     "title": "Max Slots",
     "type": "integer"
    },
    "start_date": {
     "anyOf": [
      {
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Start Date"
    }
   },
   "title": "free_slotsArguments",
   "type": "object"
  },
  "name": "free_slots",
  "output_schema": {
   "$defs": {
    "Slot": {
     "properties": {
      "end": {
       "title": "End",
       "type": "string"
      },
      "label": {
       "title": "Label",
       "type": "string"
      },
      "start": {
       "title": "Start",
       "type": "string"
      }
     },
     "required": [
      "start",
      "end",
      "label"
     ],
     "title": "Slot",
     "type": "object"
    }
   },
   "properties": {
    "slots": {
     "items": {
      "$ref": "#/$defs/Slot"
     },
     "title": "Slots",
     "type": "array"
    },
    "timezone": {
     "title": "Timezone",
     "type": "string"
    }
   },
   "required": [
    "timezone",
    "slots"
   ],
   "title": "SlotList",
   "type": "object"
  }
 }
]
