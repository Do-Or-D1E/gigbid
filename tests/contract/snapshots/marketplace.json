[
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": true,
   "readOnlyHint": false
  },
  "description": "Create a proposal DRAFT on the marketplace (no Connects spent). Call only after the user approved it.\n    With dry_run=true nothing is created; the preview shows the exact payload.",
  "input_schema": {
   "$defs": {
    "ScreeningAnswerIn": {
     "properties": {
      "answer": {
       "maxLength": 1500,
       "minLength": 1,
       "title": "Answer",
       "type": "string"
      },
      "question": {
       "maxLength": 500,
       "minLength": 1,
       "title": "Question",
       "type": "string"
      }
     },
     "required": [
      "question",
      "answer"
     ],
     "title": "ScreeningAnswerIn",
     "type": "object"
    }
   },
   "properties": {
    "bid_amount": {
     "description": "USD total (fixed) or USD per hour (hourly)",
     "exclusiveMinimum": 0,
     "maximum": 100000,
     "title": "Bid Amount",
     "type": "number"
    },
    "bid_type": {
     "pattern": "^(fixed|hourly)$",
     "title": "Bid Type",
     "type": "string"
    },
    "cover_letter": {
     "maxLength": 5000,
     "minLength": 50,
     "title": "Cover Letter",
     "type": "string"
    },
    "dry_run": {
     "default": false,
     "title": "Dry Run",
     "type": "boolean"
    },
    "idempotency_key": {
     "description": "Unique key for this write; a retry with the same key never sends twice",
     "maxLength": 128,
     "minLength": 8,
     "pattern": "^[\\w\\-:.]+$",
     "title": "Idempotency Key",
     "type": "string"
    },
    "job_id": {
     "description": "Marketplace job id",
     "maxLength": 64,
     "minLength": 3,
     "pattern": "^[\\w\\-.]+$",
     "title": "Job Id",
     "type": "string"
    },
    "screening_answers": {
     "default": [],
     "items": {
      "$ref": "#/$defs/ScreeningAnswerIn"
     },
     "maxItems": 10,
     "title": "Screening Answers",
     "type": "array"
    }
   },
   "required": [
    "job_id",
    "cover_letter",
    "bid_amount",
    "bid_type",
    "idempotency_key"
   ],
   "title": "create_proposal_draftArguments",
   "type": "object"
  },
  "name": "create_proposal_draft",
  "output_schema": {
   "$defs": {
    "Preview": {
     "description": "What would be sent and what it costs. Shown on the approval screen.",
     "properties": {
      "action": {
       "enum": [
        "create_proposal_draft",
        "submit_proposal",
        "send_message"
       ],
       "title": "Action",
       "type": "string"
      },
      "balance_after": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Balance After"
      },
      "connects_balance": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Connects Balance"
      },
      "connects_cost": {
       "default": 0,
       "title": "Connects Cost",
       "type": "integer"
      },
      "payload": {
       "additionalProperties": true,
       "title": "Payload",
       "type": "object"
      },
      "policy_warnings": {
       "items": {
        "type": "string"
       },
       "title": "Policy Warnings",
       "type": "array"
      }
     },
     "required": [
      "action",
      "payload"
     ],
     "title": "Preview",
     "type": "object"
    }
   },
   "properties": {
    "draft_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Draft Id"
    },
    "dry_run": {
     "title": "Dry Run",
     "type": "boolean"
    },
    "preview": {
     "anyOf": [
      {
       "$ref": "#/$defs/Preview"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "replay": {
     "default": false,
     "title": "Replay",
     "type": "boolean"
    },
    "status": {
     "title": "Status",
     "type": "string"
    }
   },
   "required": [
    "dry_run",
    "status"
   ],
   "title": "DraftResult",
   "type": "object"
  }
 },
